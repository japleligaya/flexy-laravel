{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": ["sin1"],
    "installCommand": "npm ci --include=dev",
    "buildCommand": "npm run build && node scripts/vercel-assets.mjs",
    "outputDirectory": ".vercel-public",
    "env": {
        "VERCEL_PHP_DOCROOT": "public"
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "excludeFiles": "{node_modules/**,.vercel-public/**,public/flexy/**,public/payroll-go/**,public/build/assets/**}"
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/.*", "dest": "/api/index.php" }
    ]
}
